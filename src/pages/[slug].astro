---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import Waitlist from '../components/Waitlist.astro';
import { getApp, getRelated, verdictLabel, categoryMeta } from '../lib/apps.js';
import { getVoteCount } from '../lib/db.js';
import { canonical, organizationName } from '../lib/site.js';

const slug = Astro.params.slug || '';
const app = getApp(slug);
if (!app) return Astro.redirect('/404');
const related = getRelated(app, 3);
const votes = getVoteCount(app.slug);
const title = `Can you replace ${app.name} with one AI coding prompt?`;
const description = `${verdictLabel(app.verdict)}: an honest breakdown of rebuilding ${app.name}, what you lose, prior art, and the one-shot AI coding prompt.`;
const faqs = [
  {
    question: `Can I really replace ${app.name} with one prompt?`,
    answer: app.verdict === 'yes'
      ? `For a focused personal or small-team use case, yes. The prompt below replaces the core outcome—not every enterprise feature ${app.name} has accumulated.`
      : app.verdict === 'kinda'
        ? `You can replace a narrow workflow, but not the entire product with equal reliability. Treat the prompt as a strong prototype specification, not a magic cloning spell.`
        : `Not responsibly as a full replacement. You can build a smaller adjacent tool, but the difficult infrastructure, legal assurance or operational reliability is the product.`
  },
  {
    question: `How much could I save by replacing ${app.name}?`,
    answer: `The listed starting point is about $${app.priceMonthly} per month. Your real saving depends on seats, usage, hosting, API fees and the value of your own maintenance time.`
  },
  {
    question: 'Which AI coding agent should I use?',
    answer: 'Claude Code, Codex and Cursor can all execute the specification. The copy buttons add agent-specific instructions, but your result will depend more on testing and iteration than the logo on the agent.'
  },
  {
    question: 'Is this production-ready after one generation?',
    answer: 'No serious software should ship unreviewed after one generation. Run the tests, inspect authentication and data handling, verify backups, and ask a specialist to review high-stakes security, legal or compliance features.'
  }
];
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer }
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: canonical('/') },
      { '@type': 'ListItem', position: 2, name: app.name, item: canonical(`/${app.slug}`) }
    ]
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: organizationName,
    url: canonical('/')
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: app.name,
    applicationCategory: app.category,
    offers: { '@type': 'Offer', price: app.priceMonthly, priceCurrency: 'USD' }
  }
];
---
<BaseLayout title={title} description={description} canonicalPath={`/${app.slug}`} ogImage={`/og/${app.slug}.png`} schemas={schemas}>
  <section class="app-hero container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">HOME</a><span>/</span><span>{app.category.toUpperCase()}</span><span>/</span><span>{app.name.toUpperCase()}</span></nav>
    <div class="app-title-grid">
      <div>
        <div class="app-kicker">
          <img class="favicon" src={`/favicons/${app.slug}.png`} width="48" height="48" alt="" />
          <div><VerdictBadge verdict={app.verdict} /><div class="app-domain" style="margin-top:8px">{app.domain}</div></div>
        </div>
        <h1>Can you vibecode <span class="green">{app.name}?</span></h1>
      </div>
      <aside class="verdict-card reveal">
        <div class="verdict-card-label">THE VERDICT</div>
        <div class={`verdict-word ${app.verdict}`}>{verdictLabel(app.verdict)}</div>
        <div class="verdict-price">TARGET: ${app.priceMonthly}/MONTH</div>
      </aside>
    </div>
  </section>

  <section class="section container" style="padding-top:30px">
    <div class="content-grid">
      <div style="display:grid;gap:22px">
        <article class="card card-pad reveal">
          <p class="eyebrow">The honest version</p>
          <h2 class="card-title">What the badge actually means</h2>
          <p class="notes">{app.notes}</p>
        </article>

        <article class="reveal">
          <div class="section-head" style="margin-bottom:14px">
            <div><p class="eyebrow">One-shot specification</p><h2 class="card-title" style="font-size:32px">The build prompt</h2></div>
          </div>
          <div class="prompt-shell">
            <div class="prompt-top">
              <span>/{app.slug}/rebuild.prompt</span>
              <div class="copy-actions">
                <button class="copy-btn" type="button" data-copy-agent="claude">CLAUDE CODE</button>
                <button class="copy-btn" type="button" data-copy-agent="codex">CODEX</button>
                <button class="copy-btn" type="button" data-copy-agent="cursor">CURSOR</button>
              </div>
            </div>
            <pre class="prompt-code" data-build-prompt>{app.prompt}</pre>
          </div>
        </article>

        <article class="card card-pad reveal">
          <p class="eyebrow">Reality tax</p>
          <h2 class="card-title">What you lose</h2>
          <ul class="loss-list">{app.whatYouLose.map((loss) => <li>{loss}</li>)}</ul>
        </article>

        <article class="card card-pad reveal">
          <p class="eyebrow">Do not start from zero</p>
          <h2 class="card-title">Prior art worth studying</h2>
          <div class="prior-links">
            {app.priorArt.map((project) => <a class="prior-link" href={project.url} target="_blank" rel="noreferrer"><strong>{project.name}</strong><span class="mono">SOURCE ↗</span></a>)}
          </div>
        </article>
      </div>

      <aside class="action-stack reveal">
        <button class="vote-button" type="button" data-vote-button data-slug={app.slug}>I REPLACED THIS ↑</button>
        <a class="share-button" data-share-x href={`https://x.com/intent/post?text=${encodeURIComponent(`Can you replace ${app.name} with one AI coding prompt? ${verdictLabel(app.verdict)}.`)}&url=${encodeURIComponent(canonical(`/${app.slug}`))}`} target="_blank" rel="noreferrer">SHARE ON X ↗</a>
        <div class="vote-meter"><strong data-vote-count>{votes.toLocaleString('en-US')}</strong><span>PEOPLE SAY THEY REPLACED IT</span></div>
        <div class="card card-pad" style="padding:20px">
          <div class="verdict-card-label">CATEGORY</div><div style="margin-top:7px">{categoryMeta[app.category]?.emoji} {app.category}</div>
          <div class="verdict-card-label" style="margin-top:18px">PRICE DESTROYED</div><div style="margin-top:7px" class="mono green">${(votes * app.priceMonthly).toLocaleString('en-US')}/MO</div>
        </div>
      </aside>
    </div>
  </section>

  <section class="section container reveal">
    <div class="section-head"><div><p class="eyebrow">Keep browsing</p><h2>Related targets</h2></div></div>
    <div class="related-grid">
      {related.map((item) => (
        <a class="related-card" href={`/${item.slug}`}>
          <img class="favicon" src={`/favicons/${item.slug}.png`} width="34" height="34" alt="" loading="lazy" />
          <h3>{item.name}</h3>
          <div class="related-meta">${item.priceMonthly}/MO · {verdictLabel(item.verdict)}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="section container reveal">
    <div class="section-head"><div><p class="eyebrow">Before you cancel</p><h2>FAQ</h2></div></div>
    <div class="faq">
      {faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}
    </div>
  </section>

  <section class="section container"><Waitlist source={app.slug} /></section>

  <script is:inline define:vars={{ appSlug: app.slug }}>
    const agentPrefixes = {
      claude: 'Open Claude Code in a new empty repository. Work autonomously, create every required file, install dependencies, run the application and tests, fix errors, and do not stop at a plan. Implement this specification:',
      codex: 'Use Codex CLI in an empty repository. Create the complete implementation directly, run linting and tests, inspect failures, and iterate until the app works. Follow this specification:',
      cursor: 'Use Cursor Agent mode with permission to edit the whole repository. Build the complete app, run it locally, fix all errors, and validate the main user flows. Here is the specification:'
    };
    const prompt = document.querySelector('[data-build-prompt]')?.textContent?.trim() || '';
    document.querySelectorAll('[data-copy-agent]').forEach((button) => {
      button.addEventListener('click', async () => {
        const original = button.textContent;
        try {
          await navigator.clipboard.writeText(`${agentPrefixes[button.dataset.copyAgent]}\n\n${prompt}`);
          button.textContent = 'COPIED ✓';
        } catch {
          button.textContent = 'COPY FAILED';
        }
        setTimeout(() => button.textContent = original, 1600);
      });
    });

    const voteButton = document.querySelector('[data-vote-button]');
    const voteCount = document.querySelector('[data-vote-count]');
    voteButton?.addEventListener('click', async () => {
      voteButton.disabled = true;
      const original = voteButton.textContent;
      voteButton.textContent = 'REGISTERING…';
      try {
        const response = await fetch('/api/vote', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ slug: appSlug })
        });
        const data = await response.json();
        if (data.count) voteCount.textContent = Number(data.count).toLocaleString('en-US');
        voteButton.textContent = data.accepted ? 'VOTE RECORDED ✓' : 'ALREADY COUNTED THIS MONTH';
      } catch {
        voteButton.textContent = 'TRY AGAIN';
        voteButton.disabled = false;
      }
      if (voteButton.textContent === 'TRY AGAIN') setTimeout(() => voteButton.textContent = original, 1600);
    });
  </script>
</BaseLayout>
